<style>
.dv-avis {
  background: #0d1b2a;
  padding: 80px 64px;
  font-family: 'DM Sans', sans-serif;
}
.dv-avis__header {
  text-align: center;
  margin-bottom: 48px;
}
.dv-avis__tag {
  font-size: 11px;
  font-weight: 700;
  color: #5d9bd5;
  letter-spacing: .14em;
  text-transform: uppercase;
  margin-bottom: 10px;
}
.dv-avis__titre {
  font-size: clamp(26px, 3.5vw, 40px);
  font-weight: 800;
  color: #ffffff;
  line-height: 1.1;
  margin-bottom: 8px;
}
.dv-avis__titre em {
  color: #5d9bd5;
  font-style: normal;
}
.dv-avis__sub {
  font-size: 14px;
  color: rgba(255,255,255,.4);
  font-weight: 300;
}
.dv-avis__filtres {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-bottom: 48px;
  flex-wrap: wrap;
}
.dv-filtre {
  padding: 10px 24px;
  border-radius: 100px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid rgba(93,155,213,.3);
  background: transparent;
  color: rgba(255,255,255,.5);
  font-family: 'DM Sans', sans-serif;
  transition: all .2s;
}
.dv-filtre:hover {
  border-color: #5d9bd5;
  color: #fff;
}
.dv-filtre.active {
  background: #5d9bd5;
  border-color: #5d9bd5;
  color: #ffffff;
}
.dv-avis__liste {
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 900px;
  margin: 0 auto;
}
.dv-avis-card {
  background: #ffffff;
  border-radius: 16px;
  padding: 24px;
  display: flex;
  gap: 24px;
  align-items: flex-start;
  transition: transform .2s;
}
.dv-avis-card:hover { transform: translateY(-2px); }
.dv-avis-card[data-cat] { display: none; }
.dv-avis-card.visible { display: flex; }
.dv-avis__photos {
  display: flex;
  gap: 6px;
  flex-shrink: 0;
}
.dv-avis__photo-wrap {
  position: relative;
  width: 110px;
  height: 140px;
  border-radius: 10px;
  overflow: hidden;
  background: #e8f3fb;
  flex-shrink: 0;
}
.dv-avis__photo-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.dv-avis__photo-label {
  position: absolute;
  bottom: 6px;
  left: 6px;
  background: #0d1b2a;
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: .05em;
}
.dv-avis__photo-label.apres {
  background: #5d9bd5;
}
.dv-avis__body { flex: 1; }
.dv-avis__nom {
  font-size: 16px;
  font-weight: 800;
  color: #0d1b2a;
  margin-bottom: 3px;
}
.dv-avis__meta {
  font-size: 12px;
  color: #6b8099;
  margin-bottom: 10px;
}
.dv-avis__stars {
  color: #f4a82e;
  font-size: 14px;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.dv-avis__verifie {
  font-size: 11px;
  color: #388e3c;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 4px;
}
.dv-avis__texte {
  font-size: 14px;
  color: #1a2e42;
  line-height: 1.7;
  font-style: italic;
  margin: 12px 0;
}
.dv-avis__resultats {
  font-size: 12px;
  color: #6b8099;
  font-weight: 500;
}
.dv-avis__resultats span {
  color: #5d9bd5;
  font-weight: 700;
}

@media screen and (max-width: 749px) {
  .dv-avis { padding: 48px 20px; }
  .dv-avis-card { flex-direction: column; }
  .dv-avis__photo-wrap { width: 90px; height: 115px; }
  .dv-avis__photos { justify-content: center; }
}
</style>

<section class="dv-avis">
  <div class="dv-avis__header">
    <div class="dv-avis__tag">Avant / Après vérifiés</div>
    <div class="dv-avis__titre">Elles ont osé.<br><em>Regarde les résultats.</em></div>
    <div class="dv-avis__sub">Photos vérifiées · Achats confirmés</div>
  </div>

  <div class="dv-avis__filtres">
    <button class="dv-filtre active" data-filtre="toutes">Toutes</button>
    <button class="dv-filtre" data-filtre="poids">Perte de poids</button>
    <button class="dv-filtre" data-filtre="retention">Rétention d'eau</button>
    <button class="dv-filtre" data-filtre="postpartum">Post-partum</button>
  </div>

  <div class="dv-avis__liste">

    <!-- AVIS 1 -->
    <div class="dv-avis-card visible" data-cat="postpartum">
      <div class="dv-avis__photos">
        {% if section.settings.a1_avant != blank %}
          <div class="dv-avis__photo-wrap">
            <img src="{{ section.settings.a1_avant | img_url: '300x' }}" alt="Avant">
            <div class="dv-avis__photo-label">Avant</div>
          </div>
        {% endif %}
        {% if section.settings.a1_apres != blank %}
          <div class="dv-avis__photo-wrap">
            <img src="{{ section.settings.a1_apres | img_url: '300x' }}" alt="Après">
            <div class="dv-avis__photo-label apres">Après {{ section.settings.a1_duree }}</div>
          </div>
        {% endif %}
      </div>
      <div class="dv-avis__body">
        <div class="dv-avis__nom">{{ section.settings.a1_nom }}</div>
        <div class="dv-avis__meta">{{ section.settings.a1_meta }}</div>
        <div class="dv-avis__stars">
          ★★★★★
          <span class="dv-avis__verifie">✓ Vérifié</span>
        </div>
        <div class="dv-avis__texte">« {{ section.settings.a1_texte }} »</div>
        <div class="dv-avis__resultats">Premiers résultats : <span>{{ section.settings.a1_resultats }}</span></div>
      </div>
    </div>

    <!-- AVIS 2 -->
    <div class="dv-avis-card visible" data-cat="retention">
      <div class="dv-avis__photos">
        {% if section.settings.a2_avant != blank %}
          <div class="dv-avis__photo-wrap">
            <img src="{{ section.settings.a2_avant | img_url: '300x' }}" alt="Avant">
            <div class="dv-avis__photo-label">Avant</div>
          </div>
        {% endif %}
        {% if section.settings.a2_apres != blank %}
          <div class="dv-avis__photo-wrap">
            <img src="{{ section.settings.a2_apres | img_url: '300x' }}" alt="Après">
            <div class="dv-avis__photo-label apres">Après {{ section.settings.a2_duree }}</div>
          </div>
        {% endif %}
      </div>
      <div class="dv-avis__body">
        <div class="dv-avis__nom">{{ section.settings.a2_nom }}</div>
        <div class="dv-avis__meta">{{ section.settings.a2_meta }}</div>
        <div class="dv-avis__stars">
          ★★★★★
          <span class="dv-avis__verifie">✓ Vérifié</span>
        </div>
        <div class="dv-avis__texte">« {{ section.settings.a2_texte }} »</div>
        <div class="dv-avis__resultats">Premiers résultats : <span>{{ section.settings.a2_resultats }}</span></div>
      </div>
    </div>

    <!-- AVIS 3 -->
    <div class="dv-avis-card visible" data-cat="poids">
      <div class="dv-avis__photos">
        {% if section.settings.a3_avant != blank %}
          <div class="dv-avis__photo-wrap">
            <img src="{{ section.settings.a3_avant | img_url: '300x' }}" alt="Avant">
            <div class="dv-avis__photo-label">Avant</div>
          </div>
        {% endif %}
        {% if section.settings.a3_apres != blank %}
          <div class="dv-avis__photo-wrap">
            <img src="{{ section.settings.a3_apres | img_url: '300x' }}" alt="Après">
            <div class="dv-avis__photo-label apres">Après {{ section.settings.a3_duree }}</div>
          </div>
        {% endif %}
      </div>
      <div class="dv-avis__body">
        <div class="dv-avis__nom">{{ section.settings.a3_nom }}</div>
        <div class="dv-avis__meta">{{ section.settings.a3_meta }}</div>
        <div class="dv-avis__stars">
          ★★★★★
          <span class="dv-avis__verifie">✓ Vérifié</span>
        </div>
        <div class="dv-avis__texte">« {{ section.settings.a3_texte }} »</div>
        <div class="dv-avis__resultats">Premiers résultats : <span>{{ section.settings.a3_resultats }}</span></div>
      </div>
    </div>

  </div>
</section>

<script>
const filtres = document.querySelectorAll('.dv-filtre');
const cards = document.querySelectorAll('.dv-avis-card');

filtres.forEach(btn => {
  btn.addEventListener('click', () => {
    filtres.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const filtre = btn.dataset.filtre;
    cards.forEach(card => {
      if (filtre === 'toutes' || card.dataset.cat === filtre) {
        card.classList.add('visible');
      } else {
        card.classList.remove('visible');
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "Avis Avant Apres",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Avis 1 - Post-partum" },
    { "type": "image_picker", "id": "a1_avant", "label": "Photo avant" },
    { "type": "image_picker", "id": "a1_apres", "label": "Photo apres" },
    { "type": "text", "id": "a1_duree", "label": "Duree (ex: 1 mois)", "default": "1 mois" },
    { "type": "text", "id": "a1_nom", "label": "Prenom et age", "default": "Yasmine M., 28 ans" },
    { "type": "text", "id": "a1_meta", "label": "Categorie et cure", "default": "Post-partum · Cure Detox Draineur" },
    { "type": "textarea", "id": "a1_texte", "label": "Temoignage", "default": "Apres ma grossesse je ne reconnaissais plus mon ventre. En 14 jours avec le Detox Draineur, la retention a disparu. Je me sens enfin legere et je rentre dans mes jeans d avant grossesse !" },
    { "type": "text", "id": "a1_resultats", "label": "Premiers resultats", "default": "semaine 2" },
    { "type": "header", "content": "Avis 2 - Retention d eau" },
    { "type": "image_picker", "id": "a2_avant", "label": "Photo avant" },
    { "type": "image_picker", "id": "a2_apres", "label": "Photo apres" },
    { "type": "text", "id": "a2_duree", "label": "Duree", "default": "14 jours" },
    { "type": "text", "id": "a2_nom", "label": "Prenom et age", "default": "Camnour L., 32 ans" },
    { "type": "text", "id": "a2_meta", "label": "Categorie et cure", "default": "Retention d eau · Cure Detox Draineur" },
    { "type": "textarea", "id": "a2_texte", "label": "Temoignage", "default": "Mon ventre etait toujours gonfle, peu importe ce que je mangeais. Des la premiere semaine j ai senti la difference. Moins de ballonnements, moins de lourdeur. Je recommande a 100%." },
    { "type": "text", "id": "a2_resultats", "label": "Premiers resultats", "default": "semaine 1" },
    { "type": "header", "content": "Avis 3 - Perte de poids" },
    { "type": "image_picker", "id": "a3_avant", "label": "Photo avant" },
    { "type": "image_picker", "id": "a3_apres", "label": "Photo apres" },
    { "type": "text", "id": "a3_duree", "label": "Duree", "default": "2 mois" },
    { "type": "text", "id": "a3_nom", "label": "Prenom et age", "default": "Lydie R., 35 ans" },
    { "type": "text", "id": "a3_meta", "label": "Categorie et cure", "default": "Perte de poids · Cure Moro Fit 400" },
    { "type": "textarea", "id": "a3_texte", "label": "Temoignage", "default": "J ai perdu 5 kg en 2 mois sans regime drastique. Le Moro Fit 400 a vraiment freine mes envies de sucre et j ai plus d energie. Je continue la cure !" },
    { "type": "text", "id": "a3_resultats", "label": "Premiers resultats", "default": "semaine 3" }
  ],
  "presets": [{ "name": "Avis Avant Apres" }]
}
{% endschema %}