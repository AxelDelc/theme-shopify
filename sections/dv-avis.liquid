<style>
.dv-avis {
  background: {{ section.settings.bg_color }};
  padding: 80px 64px;
  font-family: 'DM Sans', sans-serif;
}
.dv-avis__header {
  text-align: center;
  margin-bottom: 48px;
}
.dv-avis__tag {
  font-size: 11px;
  font-weight: 700;
  color: {{ section.settings.accent_color }};
  letter-spacing: .14em;
  text-transform: uppercase;
  margin-bottom: 10px;
}
.dv-avis__titre {
  font-size: clamp(26px, 3.5vw, 40px);
  font-weight: 800;
  color: {{ section.settings.titre_color }};
  line-height: 1.1;
  margin-bottom: 8px;
}
.dv-avis__titre em {
  color: {{ section.settings.accent_color }};
  font-style: normal;
}
.dv-avis__sub {
  font-size: 14px;
  color: {{ section.settings.sub_color }};
  font-weight: 300;
}
.dv-avis__filtres {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-bottom: 48px;
  flex-wrap: wrap;
}
.dv-filtre {
  padding: 10px 24px;
  border-radius: 100px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid {{ section.settings.filtre_border }};
  background: transparent;
  color: {{ section.settings.filtre_text }};
  font-family: 'DM Sans', sans-serif;
  transition: all .2s;
}
.dv-filtre:hover {
  border-color: {{ section.settings.accent_color }};
  color: {{ section.settings.titre_color }};
}
.dv-filtre.active {
  background: {{ section.settings.accent_color }};
  border-color: {{ section.settings.accent_color }};
  color: #ffffff;
}
.dv-avis__liste {
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 900px;
  margin: 0 auto;
}
.dv-avis-card {
  background: {{ section.settings.card_bg }};
  border-radius: 16px;
  padding: 24px;
  display: none;
  gap: 28px;
  align-items: center;
  transition: transform .2s;
}
.dv-avis-card:hover { transform: translateY(-2px); }
.dv-avis-card.visible { display: flex; }
.dv-avis__photo-wrap {
  width: 220px;
  height: 220px;
  border-radius: 12px;
  overflow: hidden;
  flex-shrink: 0;
  background: #e8f3fb;
}
.dv-avis__photo-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.dv-avis__body { flex: 1; }
.dv-avis__nom {
  font-size: 16px;
  font-weight: 800;
  color: {{ section.settings.card_titre_color }};
  margin-bottom: 3px;
}
.dv-avis__meta {
  font-size: 12px;
  color: {{ section.settings.card_meta_color }};
  margin-bottom: 10px;
}
.dv-avis__stars {
  color: {{ section.settings.stars_color }};
  font-size: 14px;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.dv-avis__verifie {
  font-size: 11px;
  color: {{ section.settings.verifie_color }};
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 4px;
}
.dv-avis__texte {
  font-size: 14px;
  color: {{ section.settings.card_text_color }};
  line-height: 1.7;
  font-style: italic;
  margin: 12px 0;
}
.dv-avis__resultats {
  font-size: 12px;
  color: {{ section.settings.card_meta_color }};
  font-weight: 500;
}
.dv-avis__resultats span {
  color: {{ section.settings.accent_color }};
  font-weight: 700;
}

@media screen and (max-width: 749px) {
  .dv-avis { padding: 48px 20px; }
  .dv-avis-card { flex-direction: column; }
  .dv-avis__photo-wrap { width: 100%; height: 260px; }
}
</style>

<section class="dv-avis">
  <div class="dv-avis__header">
    <div class="dv-avis__tag">{{ section.settings.tag }}</div>
    <div class="dv-avis__titre">{{ section.settings.titre }} <em>{{ section.settings.titre_accent }}</em></div>
    <div class="dv-avis__sub">{{ section.settings.sous_titre }}</div>
  </div>

  <div class="dv-avis__filtres">
    <button class="dv-filtre active" data-filtre="toutes">{{ section.settings.filtre_toutes }}</button>
    <button class="dv-filtre" data-filtre="poids">{{ section.settings.filtre_poids }}</button>
    <button class="dv-filtre" data-filtre="retention">{{ section.settings.filtre_retention }}</button>
    <button class="dv-filtre" data-filtre="postpartum">{{ section.settings.filtre_postpartum }}</button>
  </div>

  <div class="dv-avis__liste">

    <div class="dv-avis-card visible" data-cat="{{ section.settings.a1_cat }}">
      {% if section.settings.a1_image != blank %}
        <div class="dv-avis__photo-wrap">
          <img src="{{ section.settings.a1_image | img_url: '500x500', crop: 'center' }}" alt="{{ section.settings.a1_nom }}">
        </div>
      {% endif %}
      <div class="dv-avis__body">
        <div class="dv-avis__nom">{{ section.settings.a1_nom }}</div>
        <div class="dv-avis__meta">{{ section.settings.a1_meta }}</div>
        <div class="dv-avis__stars">★★★★★ <span class="dv-avis__verifie">✓ Vérifié</span></div>
        <div class="dv-avis__texte">« {{ section.settings.a1_texte }} »</div>
        <div class="dv-avis__resultats">Premiers résultats : <span>{{ section.settings.a1_resultats }}</span></div>
      </div>
    </div>

    <div class="dv-avis-card visible" data-cat="{{ section.settings.a2_cat }}">
      {% if section.settings.a2_image != blank %}
        <div class="dv-avis__photo-wrap">
          <img src="{{ section.settings.a2_image | img_url: '500x500', crop: 'center' }}" alt="{{ section.settings.a2_nom }}">
        </div>
      {% endif %}
      <div class="dv-avis__body">
        <div class="dv-avis__nom">{{ section.settings.a2_nom }}</div>
        <div class="dv-avis__meta">{{ section.settings.a2_meta }}</div>
        <div class="dv-avis__stars">★★★★★ <span class="dv-avis__verifie">✓ Vérifié</span></div>
        <div class="dv-avis__texte">« {{ section.settings.a2_texte }} »</div>
        <div class="dv-avis__resultats">Premiers résultats : <span>{{ section.settings.a2_resultats }}</span></div>
      </div>
    </div>

    <div class="dv-avis-card visible" data-cat="{{ section.settings.a3_cat }}">
      {% if section.settings.a3_image != blank %}
        <div class="dv-avis__photo-wrap">
          <img src="{{ section.settings.a3_image | img_url: '500x500', crop: 'center' }}" alt="{{ section.settings.a3_nom }}">
        </div>
      {% endif %}
      <div class="dv-avis__body">
        <div class="dv-avis__nom">{{ section.settings.a3_nom }}</div>
        <div class="dv-avis__meta">{{ section.settings.a3_meta }}</div>
        <div class="dv-avis__stars">★★★★★ <span class="dv-avis__verifie">✓ Vérifié</span></div>
        <div class="dv-avis__texte">« {{ section.settings.a3_texte }} »</div>
        <div class="dv-avis__resultats">Premiers résultats : <span>{{ section.settings.a3_resultats }}</span></div>
      </div>
    </div>

  </div>
</section>

<script>
document.querySelectorAll('.dv-filtre').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.dv-filtre').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const filtre = btn.dataset.filtre;
    document.querySelectorAll('.dv-avis-card').forEach(card => {
      if (filtre === 'toutes' || card.dataset.cat === filtre) {
        card.classList.add('visible');
      } else {
        card.classList.remove('visible');
      }
    });
  });
});
</script>

