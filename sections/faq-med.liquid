{% assign section_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ section_id }} {
    display: block;
    width: 100%;
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  .ai-faq-section__container-{{ section_id }} {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.column_gap }}px;
    align-items: {{ section.settings.content_alignment }};
  }

  .ai-faq-section__left-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.left_content_gap }}px;
  }

  .ai-faq-section__title-{{ section_id }} {
    font-size: {{ section.settings.title_size }}px;
    color: {{ section.settings.title_color }};
    margin: 0;
    font-weight: 600;
    line-height: 1.2;
  }

  .ai-faq-section__accordion-{{ section_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.faq_spacing }}px;
  }

  .ai-faq-item-{{ section_id }} {
    border: 1px solid {{ section.settings.faq_border_color }};
    border-radius: {{ section.settings.faq_border_radius }}px;
    overflow: hidden;
    background-color: {{ section.settings.faq_background }};
  }

  .ai-faq-item__question-{{ section_id }} {
    width: 100%;
    padding: {{ section.settings.faq_padding }}px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: {{ section.settings.question_size }}px;
    color: {{ section.settings.question_color }};
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-faq-item__question-{{ section_id }}:hover {
    background-color: {{ section.settings.faq_hover_background }};
  }

  .ai-faq-item__icon-{{ section_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: {{ section.settings.icon_color }};
  }

  .ai-faq-item__icon-{{ section_id }}.active {
    transform: rotate(180deg);
  }

  .ai-faq-item__answer-wrapper-{{ section_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-faq-item__answer-{{ section_id }} {
    padding: 0 {{ section.settings.faq_padding }}px {{ section.settings.faq_padding }}px;
    font-size: {{ section.settings.answer_size }}px;
    color: {{ section.settings.answer_color }};
    line-height: 1.6;
  }

  .ai-faq-section__right-{{ section_id }} {
    display: flex;
    justify-content: {{ section.settings.image_horizontal_align }};
    align-items: {{ section.settings.image_vertical_align }};
  }

  .ai-faq-section__image-wrapper-{{ section_id }} {
    width: 100%;
    max-width: 100%;
    border-radius: {{ section.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-faq-section__image-{{ section_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-faq-section__image-placeholder-{{ section_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 768px) {
    .ai-faq-section__container-{{ section_id }} {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }
    .ai-faq-section__right-{{ section_id }} {
      order: {{ section.settings.mobile_image_position }};
    }
    .ai-faq-section__left-{{ section_id }} {
      order: {{ section.settings.mobile_content_position }};
    }
  }
{% endstyle %}

<div class="ai-faq-section-{{ section_id }}" {{ section.shopify_attributes }}>
  <div class="ai-faq-section__container-{{ section_id }}">
    
    {%- comment -%} COLONNE GAUCHE : TITRE + FAQ {%- endcomment -%}
    <div class="ai-faq-section__left-{{ section_id }}">
      {% if section.settings.title != blank %}
        <h2 class="ai-faq-section__title-{{ section_id }}">{{ section.settings.title }}</h2>
      {% endif %}

      <div class="ai-faq-section__accordion-{{ section_id }}">
        {% for block in section.blocks %}
          {% if block.type == 'faq_item' %}
            <div class="ai-faq-item-{{ section_id }}" {{ block.shopify_attributes }}>
              <button class="ai-faq-item__question-{{ section_id }}" aria-expanded="false" onclick="toggleFaq(this)">
                <span>{{ block.settings.question }}</span>
                <svg class="ai-faq-item__icon-{{ section_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="ai-faq-item__answer-wrapper-{{ section_id }}" style="max-height: 0;">
                <div class="ai-faq-item__answer-{{ section_id }}">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {%- comment -%} COLONNE DROITE : IMAGE {%- endcomment -%}
    <div class="ai-faq-section__right-{{ section_id }}">
      <div class="ai-faq-section__image-wrapper-{{ section_id }}">
        {% if section.settings.image %}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" class="ai-faq-section__image-{{ section_id }}">
        {% else %}
          <div class="ai-faq-section__image-placeholder-{{ section_id }}">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</div>

<script>
  function toggleFaq(button) {
    const wrapper = button.nextElementSibling;
    const icon = button.querySelector('svg');
    const isOpen = button.getAttribute('aria-expanded') === 'true';

    // Fermer les autres (optionnel, retirez si vous voulez que plusieurs restent ouverts)
    // const allWrappers = document.querySelectorAll('.ai-faq-item__answer-wrapper-{{ section_id }}');
    // allWrappers.forEach(w => w.style.maxHeight = '0');

    if (isOpen) {
      button.setAttribute('aria-expanded', 'false');
      wrapper.style.maxHeight = '0';
      icon.classList.remove('active');
    } else {
      button.setAttribute('aria-expanded', 'true');
      wrapper.style.maxHeight = wrapper.scrollHeight + "px";
      icon.classList.add('active');
    }
  }
</script>

{% schema %}
{
  "name": "FAQ avec Image Latérale",
  "settings": [
    {
      "type": "header",
      "content": "Structure & Alignement"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Largeur max du contenu",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignement vertical (Colonnes)",
      "options": [
        { "value": "start", "label": "Haut" },
        { "value": "center", "label": "Milieu" },
        { "value": "end", "label": "Bas" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Couleurs & Espacement"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond section",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top", "label": "Padding Haut", "min": 0, "max": 100, "default": 60, "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom", "label": "Padding Bas", "min": 0, "max": 100, "default": 60, "unit": "px"
    },
    {
      "type": "header",
      "content": "Titre"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre Principal",
      "default": "Questions Fréquentes"
    },
    {
      "type": "range",
      "id": "title_size", "label": "Taille Titre", "min": 20, "max": 80, "default": 40, "unit": "px"
    },
    {
      "type": "color",
      "id": "title_color", "label": "Couleur Titre", "default": "#000000"
    },
    {
      "type": "header",
      "content": "Style FAQ"
    },
    {
      "type": "color",
      "id": "faq_background", "label": "Fond des questions", "default": "#f9f9f9"
    },
    {
      "type": "range",
      "id": "faq_padding", "label": "Padding interne FAQ", "min": 10, "max": 50, "default": 20, "unit": "px"
    },
    {
      "type": "range",
      "id": "faq_spacing", "label": "Espace entre questions", "min": 0, "max": 40, "default": 15, "unit": "px"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image de droite"
    },
    {
      "type": "range",
      "id": "image_border_radius", "label": "Arrondi image", "min": 0, "max": 50, "default": 10, "unit": "px"
    },
    {
      "type": "select",
      "id": "image_vertical_align",
      "label": "Position image",
      "options": [
        { "value": "flex-start", "label": "Haut" },
        { "value": "center", "label": "Centre" },
        { "value": "flex-end", "label": "Bas" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question / Réponse",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "La question",
          "default": "Comment puis-je vous aider ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "La réponse",
          "default": "<p>Voici la réponse détaillée à votre question.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ avec Image Latérale",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}
