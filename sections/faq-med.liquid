{% assign id = section.id %}

<style>
.ai-faq-{{ id }} {
  width: 100%;
  max-width: 1200px;
  margin: auto;
  padding: 60px 20px;
}

.ai-faq-container-{{ id }} {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

/* LEFT */

.ai-faq-left-{{ id }} {
  display: flex;
  flex-direction: column;
  gap: 25px;
}

.ai-faq-title-{{ id }} {
  font-size: {{ section.settings.title_size }}px;
  color: {{ section.settings.title_color }};
  font-weight: 700;
}

/* ACCORDION */

.ai-faq-wrapper-{{ id }} {
  background: {{ section.settings.accordion_wrapper_bg }};
  padding: 20px;
  border-radius: 10px;
}

.ai-faq-item-{{ id }} {
  border-bottom: 1px solid {{ section.settings.accordion_border_color }};
}

.ai-faq-question-{{ id }} {
  width: 100%;
  background: {{ section.settings.accordion_bg_color }};
  border: none;
  padding: 15px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  font-weight: 600;
}

.ai-faq-icon-{{ id }} {
  transition: 0.3s;
  font-size: 20px;
}

.ai-faq-item-{{ id }}.active .ai-faq-icon-{{ id }} {
  transform: rotate(45deg);
}

/* ANSWER */

.ai-faq-answer-{{ id }} {
  max-height: 0;
  overflow: hidden;
  transition: 0.3s;
  background: {{ section.settings.answer_bg_color }};
}

.ai-faq-answer-content-{{ id }} {
  padding: 15px;
  color: {{ section.settings.answer_color }};
  line-height: 1.6;
}

/* IMAGE */

.ai-faq-right-{{ id }} {
  display: flex;
  justify-content: center;
  align-items: {{ section.settings.image_vertical_align }};
}

.ai-faq-image-{{ id }} {
  width: 100%;
  max-width: 450px;
  border-radius: {{ section.settings.image_border_radius }}px;
}

/* MOBILE */

@media(max-width:768px){

  .ai-faq-container-{{ id }} {
    grid-template-columns: 1fr;
  }

}
</style>


<section class="ai-faq-{{ id }}">

  <div class="ai-faq-container-{{ id }}">

    <!-- LEFT -->
    <div class="ai-faq-left-{{ id }}">

      {% if section.settings.title != blank %}
        <h2 class="ai-faq-title-{{ id }}">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      <div class="ai-faq-wrapper-{{ id }}">

        {% for block in section.blocks %}

          <div class="ai-faq-item-{{ id }}">

            <button type="button" class="ai-faq-question-{{ id }}">

              {{ block.settings.question }}

              <span class="ai-faq-icon-{{ id }}">+</span>

            </button>


            <div class="ai-faq-answer-{{ id }}">

              <div class="ai-faq-answer-content-{{ id }}">
                {{ block.settings.answer }}
              </div>

            </div>

          </div>

        {% endfor %}

      </div>

    </div>


    <!-- RIGHT -->
    <div class="ai-faq-right-{{ id }}">

      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1000 }}"
          class="ai-faq-image-{{ id }}"
          loading="lazy"
          alt="FAQ"
        >
      {% endif %}

    </div>

  </div>

</section>


<script>
(function(){

  const section = document.querySelector(".ai-faq-{{ id }}");
  if(!section) return;

  const items = section.querySelectorAll(".ai-faq-item-{{ id }}");

  items.forEach(item=>{

    const btn = item.querySelector("button");
    const answer = item.querySelector(".ai-faq-answer-{{ id }}");
    const icon = item.querySelector(".ai-faq-icon-{{ id }}");

    btn.addEventListener("click", ()=>{

      if(item.classList.contains("active")){
        item.classList.remove("active");
        answer.style.maxHeight = null;
        icon.textContent = "+";
      }
      else{
        item.classList.add("active");
        answer.style.maxHeight = answer.scrollHeight + "px";
        icon.textContent = "−";
      }

    });

  });

})();
</script>


{% schema %}
{
  "name": "FAQ avec image",
  "settings": [

    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Vos questions, nos réponses"
    },

    {
      "type": "range",
      "id": "title_size",
      "label": "Taille du titre",
      "min": 18,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 32
    },

    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur du titre",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "accordion_wrapper_bg",
      "label": "Fond FAQ",
      "default": "#f3f3f3"
    },

    {
      "type": "color",
      "id": "accordion_bg_color",
      "label": "Fond questions",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "accordion_border_color",
      "label": "Couleur bordure",
      "default": "#dddddd"
    },

    {
      "type": "color",
      "id": "answer_bg_color",
      "label": "Fond réponses",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "answer_color",
      "label": "Couleur texte réponses",
      "default": "#555555"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },

    {
      "type": "select",
      "id": "image_vertical_align",
      "label": "Alignement image",
      "default": "center",
      "options": [
        { "value":"flex-start","label":"Haut"},
        { "value":"center","label":"Centre"},
        { "value":"flex-end","label":"Bas"}
      ]
    },

    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Arrondi image",
      "min":0,
      "max":40,
      "step":2,
      "unit":"px",
      "default":12
    }

  ],


  "blocks":[

    {
      "type":"faq",
      "name":"Question / Réponse",
      "settings":[

        {
          "type":"text",
          "id":"question",
          "label":"Question"
        },

        {
          "type":"richtext",
          "id":"answer",
          "label":"Réponse"
        }

      ]
    }

  ],


  "presets":[
    {
      "name":"FAQ avec image"
    }
  ]
}
{% endschema %}

