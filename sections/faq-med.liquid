{% assign id = section.id %}

<style>
.faq-ai-{{ id }} {
  max-width: 1200px;
  margin: auto;
  padding: 60px 20px;
}

.faq-ai-container-{{ id }} {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

/* LEFT */

.faq-ai-left-{{ id }} {
  display: flex;
  flex-direction: column;
  gap: 25px;
}

.faq-ai-title-{{ id }} {
  font-size: {{ section.settings.title_size }}px;
  font-weight: 700;
}

/* ACCORDION */

.faq-ai-accordion-{{ id }} {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.faq-ai-item-{{ id }} {
  border-bottom: 1px solid #e5e5e5;
}

.faq-ai-question-{{ id }} {
  width: 100%;
  background: transparent;
  border: none;
  padding: 15px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  text-align: left;
}

.faq-ai-icon-{{ id }} {
  width: 20px;
  transition: 0.3s;
}

/* ANSWER */

.faq-ai-answer-wrapper-{{ id }} {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s ease;
}

.faq-ai-answer-{{ id }} {
  padding: 0 0 15px;
  line-height: 1.6;
  color: #555;
}

/* ACTIVE */

.faq-ai-item-{{ id }}.active .faq-ai-icon-{{ id }} {
  transform: rotate(180deg);
}

/* IMAGE */

.faq-ai-right-{{ id }} {
  display: flex;
  justify-content: center;
  align-items: {{ section.settings.image_align }};
}

.faq-ai-image-{{ id }} {
  width: 100%;
  max-width: 450px;
  border-radius: 12px;
}

/* MOBILE */

@media(max-width:768px){

  .faq-ai-container-{{ id }} {
    grid-template-columns: 1fr;
  }

}
</style>


<section class="faq-ai-{{ id }}">

  <div class="faq-ai-container-{{ id }}">

    <!-- LEFT -->
    <div class="faq-ai-left-{{ id }}">

      {% if section.settings.title != blank %}
        <h2 class="faq-ai-title-{{ id }}">
          {{ section.settings.title }}
        </h2>
      {% endif %}


      <div class="faq-ai-accordion-{{ id }}">

        {% for block in section.blocks %}

          <div class="faq-ai-item-{{ id }}">

            <button class="faq-ai-question-{{ id }}">
              <span>{{ block.settings.question }}</span>

              <svg class="faq-ai-icon-{{ id }}"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2">

                <polyline points="6 9 12 15 18 9"/>

              </svg>
            </button>


            <div class="faq-ai-answer-wrapper-{{ id }}">

              <div class="faq-ai-answer-{{ id }}">
                {{ block.settings.answer }}
              </div>

            </div>

          </div>

        {% endfor %}

      </div>

    </div>


    <!-- RIGHT -->
    <div class="faq-ai-right-{{ id }}">

      {% if section.settings.image %}
        <img
          src="{{ section.settings.image | image_url: width: 1000 }}"
          class="faq-ai-image-{{ id }}"
          loading="lazy"
        >
      {% endif %}

    </div>

  </div>

</section>


<script>
(function(){

  const section = document.querySelector(".faq-ai-{{ id }}");

  if(!section) return;

  const items = section.querySelectorAll(".faq-ai-item-{{ id }}");

  items.forEach(item => {

    const btn = item.querySelector("button");
    const answer = item.querySelector(".faq-ai-answer-wrapper-{{ id }}");

    btn.addEventListener("click", ()=>{

      if(item.classList.contains("active")){
        item.classList.remove("active");
        answer.style.maxHeight = null;
      }
      else{
        item.classList.add("active");
        answer.style.maxHeight = answer.scrollHeight + "px";
      }

    });

  });

})();
</script>


{% schema %}
{
  "name": "FAQ AI Style",
  "settings": [

    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Vos questions, nos réponses"
    },

    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 18,
      "max": 50,
      "step": 2,
      "default": 32
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },

    {
      "type": "select",
      "id": "image_align",
      "label": "Image vertical position",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ]
    }

  ],


  "blocks": [

    {
      "type": "faq",
      "name": "FAQ",
      "settings": [

        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },

        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }

      ]
    }

  ],


  "presets": [
    {
      "name": "FAQ AI Style"
    }
  ]
}
{% endschema %}

