{% if template == 'index' %}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>
.dv-hero {
  position: relative;
  min-height: 640px;
  display: flex;
  align-items: center;
  overflow: hidden;
  font-family: 'DM Sans', sans-serif;
  background: #0d1b2a;
}
.dv-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.dv-hero__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.dv-hero__bg .dv-mobile { display: none; }
.dv-hero__bg .dv-desktop { display: block; }
.dv-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(to right, rgba(0,0,0,0.55) 40%, rgba(0,0,0,0.05) 100%);
}
.dv-hero__content {
  position: relative;
  z-index: 2;
  padding: 64px;
  max-width: 580px;
}
.dv-hero__title {
  font-family: 'DM Sans', sans-serif;
  font-weight: 800;
  font-size: 56px;
  line-height: 1.08;
  color: #ffffff;
  margin-bottom: 16px;
}
.dv-hero__title .dv-accent {
  color: #5d9bd5;
}
.dv-hero__sub {
  font-size: 16px;
  line-height: 1.65;
  color: rgba(255,255,255,0.65);
  max-width: 440px;
  margin-bottom: 28px;
  font-weight: 300;
}
.dv-hero__pills {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 36px;
}
.dv-hero__pill {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #0d2035;
  border: 1px solid #2a4a6a;
  color: #cce0f0;
  font-size: 12px;
  padding: 6px 14px;
  border-radius: 100px;
}
.dv-hero__pill-check { color: #5d9bd5; }
.dv-hero__ctas {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  align-items: center;
}
.dv-btn-primary {
  background: #5d9bd5;
  color: #ffffff;
  border: none;
  padding: 15px 32px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 500;
  cursor: pointer;
  font-family: 'DM Sans', sans-serif;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: opacity .2s, transform .15s;
}
.dv-btn-primary:hover { opacity: .85; transform: translateY(-1px); color: #fff; }
.dv-btn-secondary {
  background: transparent;
  color: #ffffff;
  border: 1px solid #ffffff;
  padding: 15px 32px;
  border-radius: 12px;
  font-size: 15px;
  font-family: 'DM Sans', sans-serif;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: opacity .2s;
}
.dv-btn-secondary:hover { opacity: .75; color: #fff; }

@media screen and (max-width: 749px) {
  .dv-hero {
    min-height: 760px;
    align-items: flex-end;
  }
  .dv-hero__bg .dv-desktop { display: none; }
  .dv-hero__bg .dv-mobile { display: block; }
  .dv-hero__overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.55) 50%, rgba(0,0,0,0.05) 100%);
  }
  .dv-hero__content {
    padding: 28px 20px 36px;
    max-width: 100%;
    width: 100%;
  }
  .dv-hero__title { font-size: 40px; line-height: 1.1; margin-bottom: 12px; }
  .dv-hero__sub { font-size: 14px; max-width: 100%; margin-bottom: 20px; color: rgba(255,255,255,0.7); }
  .dv-hero__pills { gap: 8px; margin-bottom: 24px; }
  .dv-hero__pill { font-size: 11px; padding: 5px 12px; }
  .dv-hero__ctas { flex-direction: column; gap: 10px; width: 100%; }
  .dv-btn-primary, .dv-btn-secondary {
    width: 100%;
    justify-content: center;
    padding: 14px 20px;
    font-size: 14px;
    border-radius: 10px;
  }
}
</style>

<section class="dv-hero">
  <div class="dv-hero__bg">
    {% if section.settings.image != blank %}
      <img class="dv-desktop" src="{{ section.settings.image | img_url: '2000x' }}" alt="Hero Docteur V" loading="eager">
    {% endif %}
    {% if section.settings.image_mobile != blank %}
      <img class="dv-mobile" src="{{ section.settings.image_mobile | img_url: '800x' }}" alt="Hero mobile" loading="eager">
    {% elsif section.settings.image != blank %}
      <img class="dv-mobile" src="{{ section.settings.image | img_url: '800x' }}" alt="Hero mobile" loading="eager">
    {% endif %}
  </div>

  <div class="dv-hero__overlay"></div>

  <div class="dv-hero__content">
    <h1 class="dv-hero__title">
      Tu gonfles.<br>
      Tu bloques.<br>
      <span class="dv-accent">On règle ça.</span>
    </h1>

    <p class="dv-hero__sub">Rétention d'eau, ventre gonflé, kilos qui ne partent pas. Notre cure 3-en-1 agit en 14 jours.</p>

    <div class="dv-hero__pills">
      <div class="dv-hero__pill"><span class="dv-hero__pill-check">✓</span> Cliniquement validé</div>
      <div class="dv-hero__pill"><span class="dv-hero__pill-check">✓</span> 100% naturel</div>
      <div class="dv-hero__pill"><span class="dv-hero__pill-check">✓</span> Fabriqué en France 🇫🇷</div>
    </div>

    <div class="dv-hero__ctas">
      <a href="{{ section.settings.cta1_lien }}" class="dv-btn-primary">Je veux mes résultats →</a>
      <a href="{{ section.settings.cta2_lien }}" class="dv-btn-secondary">Voir les cures</a>
    </div>
  </div>
</section>

{% endif %}

{% schema %}
{
  "name": "Hero Docteur V",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Photo mobile portrait" },
    { "type": "url", "id": "cta1_lien", "label": "Lien bouton Je veux mes resultats" },
    { "type": "url", "id": "cta2_lien", "label": "Lien bouton Voir les cures" }
  ],
  "presets": [{ "name": "Hero Docteur V" }]
}
{% endschema %}