<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&family=Playfair+Display:wght@700;900&family=Montserrat:wght@600;700;800&family=Raleway:wght@700;800&display=swap" rel="stylesheet">

<style>
.dv-hero {
  position: relative;
  min-height: {{ section.settings.hero_height }}px;
  display: flex;
  align-items: center;
  overflow: hidden;
  font-family: 'DM Sans', sans-serif;
  background: {{ section.settings.bg_color }};
  margin-top: -66px;
  padding-top: 66px;
}
.dv-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.dv-hero__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: {{ section.settings.image_position }};
  display: block;
}
.dv-hero__bg .dv-mobile { display: none; }
.dv-hero__bg .dv-desktop { display: block; }
.dv-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(to right, rgba(0,0,0,{{ section.settings.overlay_opacity }}) 40%, rgba(0,0,0,0.1) 100%);
}
.dv-hero__content {
  position: relative;
  z-index: 2;
  padding: 64px;
  max-width: 600px;
}
.dv-hero__badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: {{ section.settings.badge_bg_color }};
  border: 1px solid {{ section.settings.badge_border_color }};
  color: {{ section.settings.badge_text_color }};
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  padding: 7px 16px;
  border-radius: 100px;
  margin-bottom: 20px;
  width: fit-content;
}
.dv-hero__badge-dot {
  width: 6px;
  height: 6px;
  background: {{ section.settings.accent_color }};
  border-radius: 50%;
  animation: dvPulse 2s infinite;
  flex-shrink: 0;
}
.dv-hero__title {
  font-family: {{ section.settings.titre_font }};
  font-weight: {{ section.settings.titre_weight }};
  font-size: {{ section.settings.titre_size }}px;
  line-height: 1.08;
  color: {{ section.settings.titre_color }};
  margin-bottom: 16px;
}
.dv-hero__title .dv-accent {
  color: {{ section.settings.accent_color }};
}
.dv-hero__sub {
  font-size: {{ section.settings.sub_size }}px;
  line-height: 1.65;
  color: {{ section.settings.sub_color }};
  max-width: 440px;
  margin-bottom: 28px;
  font-weight: 300;
}
.dv-hero__pills {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 36px;
}
.dv-hero__pill {
  display: flex;
  align-items: center;
  gap: 6px;
  background: {{ section.settings.pill_bg_color }};
  border: 1px solid {{ section.settings.pill_border_color }};
  color: {{ section.settings.pill_text_color }};
  font-size: 12px;
  padding: 6px 14px;
  border-radius: 100px;
}
.dv-hero__pill-check { color: {{ section.settings.accent_color }}; }
.dv-hero__ctas {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  align-items: center;
}
.dv-btn-primary {
  background: {{ section.settings.btn1_bg }};
  color: {{ section.settings.btn1_text }};
  border: none;
  padding: 15px 32px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 500;
  cursor: pointer;
  font-family: 'DM Sans', sans-serif;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: opacity .2s, transform .15s;
}
.dv-btn-primary:hover { opacity: .85; transform: translateY(-1px); color: {{ section.settings.btn1_text }}; }
.dv-btn-secondary {
  background: {{ section.settings.btn2_bg }};
  color: {{ section.settings.btn2_text }};
  border: 1px solid {{ section.settings.btn2_border }};
  padding: 15px 32px;
  border-radius: 12px;
  font-size: 15px;
  font-family: 'DM Sans', sans-serif;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: opacity .2s;
}
.dv-btn-secondary:hover { opacity: .75; color: {{ section.settings.btn2_text }}; }

@keyframes dvPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .3; }
}

@media screen and (max-width: 749px) {
  .dv-hero {
    min-height: {{ section.settings.hero_height_mobile }}px;
    align-items: flex-end;
    margin-top: -60px;
    padding-top: 60px;
  }
  .dv-hero__bg .dv-desktop { display: none; }
  .dv-hero__bg .dv-mobile { display: block; }
  .dv-hero__overlay {
    background: linear-gradient(to top,
      rgba(0,0,0,0.92) 0%,
      rgba(0,0,0,0.55) 50%,
      rgba(0,0,0,0.05) 100%
    );
  }
  .dv-hero__content {
    padding: 28px 20px 36px;
    max-width: 100%;
    width: 100%;
  }
  .dv-hero__badge {
    font-size: 10px;
    padding: 6px 14px;
    margin-bottom: 16px;
  }
  .dv-hero__title {
    font-size: {{ section.settings.titre_size_mobile }}px;
    line-height: 1.1;
    margin-bottom: 12px;
  }
  .dv-hero__sub {
    font-size: 14px;
    max-width: 100%;
    margin-bottom: 20px;
    color: rgba(255,255,255,0.7);
  }
  .dv-hero__pills {
    gap: 8px;
    margin-bottom: 24px;
  }
  .dv-hero__pill {
    font-size: 11px;
    padding: 5px 12px;
  }
  .dv-hero__ctas {
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }
  .dv-btn-primary,
  .dv-btn-secondary {
    width: 100%;
    justify-content: center;
    padding: 14px 20px;
    font-size: 14px;
    border-radius: 10px;
  }
}
</style>

<section class="dv-hero">
  <div class="dv-hero__bg">
    {% if section.settings.image != blank %}
      <img class="dv-desktop"
           src="{{ section.settings.image | img_url: '2000x' }}"
           alt="Hero Docteur V"
           loading="eager">
    {% endif %}
    {% if section.settings.image_mobile != blank %}
      <img class="dv-mobile"
           src="{{ section.settings.image_mobile | img_url: '800x' }}"
           alt="Hero Docteur V mobile"
           loading="eager">
    {% elsif section.settings.image != blank %}
      <img class="dv-mobile"
           src="{{ section.settings.image | img_url: '800x' }}"
           alt="Hero Docteur V mobile"
           loading="eager">
    {% endif %}
  </div>

  <div class="dv-hero__overlay"></div>

  <div class="dv-hero__content">
    {% if section.settings.badge_text != blank %}
      <div class="dv-hero__badge">
        <div class="dv-hero__badge-dot"></div>
        {{ section.settings.badge_text }}
      </div>
    {% endif %}

    <h1 class="dv-hero__title">
      {{ section.settings.titre_ligne1 }}<br>
      {{ section.settings.titre_ligne2 }}<br>
      <span class="dv-accent">{{ section.settings.titre_ligne3_accent }}</span>
    </h1>

    {% if section.settings.sous_titre != blank %}
      <p class="dv-hero__sub">{{ section.settings.sous_titre }}</p>
    {% endif %}

    <div class="dv-hero__pills">
      {% if section.settings.pill1 != blank %}
        <div class="dv-hero__pill"><span class="dv-hero__pill-check">✓</span> {{ section.settings.pill1 }}</div>
      {% endif %}
      {% if section.settings.pill2 != blank %}
        <div class="dv-hero__pill"><span class="dv-hero__pill-check">✓</span> {{ section.settings.pill2 }}</div>
      {% endif %}
      {% if section.settings.pill3 != blank %}
        <div class="dv-hero__pill"><span class="dv-hero__pill-check">✓</span> {{ section.settings.pill3 }}</div>
      {% endif %}
    </div>

    <div class="dv-hero__ctas">
      {% if section.settings.cta1_texte != blank %}
        <a href="{{ section.settings.cta1_lien }}" class="dv-btn-primary">{{ section.settings.cta1_texte }}</a>
      {% endif %}
      {% if section.settings.cta2_texte != blank %}
        <a href="{{ section.settings.cta2_lien }}" class="dv-btn-secondary">{{ section.settings.cta2_texte }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Docteur V",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image", "label": "Photo desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Photo mobile portrait" },
    { "type": "select", "id": "image_position", "label": "Position photo", "options": [
      { "value": "center center", "label": "Centre" },
      { "value": "top center", "label": "Haut" },
      { "value": "bottom center", "label": "Bas" },
      { "value": "center left", "label": "Gauche" },
      { "value": "center right", "label": "Droite" }
    ], "default": "center center" },
    { "type": "select", "id": "overlay_opacity", "label": "Intensite du voile", "options": [
      { "value": "0.4", "label": "Leger" },
      { "value": "0.6", "label": "Moyen" },
      { "value": "0.75", "label": "Fort" },
      { "value": "0.88", "label": "Tres fort" }
    ], "default": "0.75" },
    { "type": "header", "content": "Hauteurs" },
    { "type": "range", "id": "hero_height", "label": "Hauteur desktop (px)", "min": 400, "max": 900, "step": 20, "default": 640 },
    { "type": "range", "id": "hero_height_mobile", "label": "Hauteur mobile (px)", "min": 500, "max": 1000, "step": 20, "default": 760 },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "bg_color", "label": "Fond si pas de photo", "default": "#0d1b2a" },
    { "type": "color", "id": "accent_color", "label": "Couleur accent", "default": "#5d9bd5" },
    { "type": "header", "content": "Titre" },
    { "type": "select", "id": "titre_font", "label": "Police titre", "options": [
      { "value": "'Syne', sans-serif", "label": "Syne" },
      { "value": "'Playfair Display', serif", "label": "Playfair" },
      { "value": "'Montserrat', sans-serif", "label": "Montserrat" },
      { "value": "'Raleway', sans-serif", "label": "Raleway" },
      { "value": "'DM Sans', sans-serif", "label": "DM Sans" }
    ], "default": "'Syne', sans-serif" },
    { "type": "select", "id": "titre_weight", "label": "Epaisseur", "options": [
      { "value": "400", "label": "Normal" },
      { "value": "700", "label": "Bold" },
      { "value": "800", "label": "Extra bold" },
      { "value": "900", "label": "Black" }
    ], "default": "800" },
    { "type": "range", "id": "titre_size", "label": "Taille desktop (px)", "min": 32, "max": 80, "step": 2, "default": 56 },
    { "type": "range", "id": "titre_size_mobile", "label": "Taille mobile (px)", "min": 28, "max": 60, "step": 2, "default": 40 },
    { "type": "color", "id": "titre_color", "label": "Couleur titre", "default": "#ffffff" },
    { "type": "text", "id": "titre_ligne1", "label": "Titre ligne 1", "default": "Mince." },
    { "type": "text", "id": "titre_ligne2", "label": "Titre ligne 2", "default": "Drain." },
    { "type": "text", "id": "titre_ligne3_accent", "label": "Titre ligne 3 couleur accent", "default": "Recommence." },
    { "type": "header", "content": "Sous-titre" },
    { "type": "range", "id": "sub_size", "label": "Taille (px)", "min": 12, "max": 20, "step": 1, "default": 16 },
    { "type": "color", "id": "sub_color", "label": "Couleur", "default": "#aabbcc" },
    { "type": "textarea", "id": "sous_titre", "label": "Texte", "default": "Deux formules pour se completer. Le Moro Fit 400 brule. Le Detox Draineur elimine." },
    { "type": "header", "content": "Badge" },
    { "type": "text", "id": "badge_text", "label": "Texte badge", "default": "Nouveaute disponible" },
    { "type": "color", "id": "badge_bg_color", "label": "Fond", "default": "#0d2035" },
    { "type": "color", "id": "badge_border_color", "label": "Bordure", "default": "#5d9bd5" },
    { "type": "color", "id": "badge_text_color", "label": "Texte", "default": "#7dbde8" },
    { "type": "header", "content": "Pills" },
    { "type": "text", "id": "pill1", "label": "Pill 1", "default": "Cliniquement valide" },
    { "type": "text", "id": "pill2", "label": "Pill 2", "default": "100% naturel" },
    { "type": "text", "id": "pill3", "label": "Pill 3", "default": "Fabrique en France" },
    { "type": "color", "id": "pill_bg_color", "label": "Fond", "default": "#0d2035" },
    { "type": "color", "id": "pill_border_color", "label": "Bordure", "default": "#2a4a6a" },
    { "type": "color", "id": "pill_text_color", "label": "Texte", "default": "#cce0f0" },
    { "type": "header", "content": "Bouton principal" },
    { "type": "text", "id": "cta1_texte", "label": "Texte", "default": "Decouvrir la cure complete" },
    { "type": "url", "id": "cta1_lien", "label": "Lien" },
    { "type": "color", "id": "btn1_bg", "label": "Fond", "default": "#5d9bd5" },
    { "type": "color", "id": "btn1_text", "label": "Texte", "default": "#ffffff" },
    { "type": "header", "content": "Bouton secondaire" },
    { "type": "text", "id": "cta2_texte", "label": "Texte", "default": "Voir les produits" },
    { "type": "url", "id": "cta2_lien", "label": "Lien" },
    { "type": "color", "id": "btn2_bg", "label": "Fond", "default": "#00000000" },
    { "type": "color", "id": "btn2_text", "label": "Texte", "default": "#ffffff" },
    { "type": "color", "id": "btn2_border", "label": "Bordure", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Hero Docteur V" }]
}
{% endschema %}