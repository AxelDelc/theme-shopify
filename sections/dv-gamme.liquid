<style>
.dv-gamme {
  background: {{ section.settings.bg_color }};
  padding: 80px 64px;
  font-family: 'DM Sans', sans-serif;
}
.dv-gamme__tag {
  font-size: 11px;
  font-weight: 700;
  color: {{ section.settings.accent_color }};
  letter-spacing: .12em;
  text-transform: uppercase;
  margin-bottom: 10px;
}
.dv-gamme__titre {
  font-size: clamp(28px, 3.5vw, 42px);
  font-weight: 800;
  color: #0d1b2a;
  line-height: 1.1;
  margin-bottom: 48px;
}
.dv-gamme__titre em {
  color: {{ section.settings.accent_color }};
  font-style: normal;
}
.dv-gamme__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}
.dv-card {
  background: {{ section.settings.card_bg }};
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid #e8eef5;
  display: grid;
  grid-template-columns: 1fr 1fr;
  transition: box-shadow .25s, transform .25s;
}
.dv-card:hover {
  box-shadow: 0 12px 40px rgba(93,155,213,.12);
  transform: translateY(-2px);
}
.dv-card--featured {
  border: 2px solid {{ section.settings.accent_color }};
}
.dv-card__img {
  min-height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: {{ section.settings.img_bg_p1 }};
}
.dv-card__img--p2 {
  background: {{ section.settings.img_bg_p2 }};
}
.dv-card__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.dv-card__new {
  position: absolute;
  top: 16px;
  left: 16px;
  background: {{ section.settings.accent_color }};
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 100px;
}
.dv-card__info {
  padding: 32px 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.dv-card__tag {
  font-size: 10px;
  color: {{ section.settings.accent_color }};
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
  margin-bottom: 8px;
}
.dv-card__name {
  font-size: 18px;
  font-weight: 800;
  color: #0d1b2a;
  line-height: 1.2;
  margin-bottom: 10px;
}
.dv-card__desc {
  font-size: 13px;
  color: #6b8099;
  line-height: 1.65;
  margin-bottom: 18px;
}
.dv-card__benefits {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-bottom: 22px;
}
.dv-card__benefits li {
  font-size: 12px;
  color: #1a2e42;
  display: flex;
  align-items: center;
  gap: 8px;
}
.dv-card__check {
  width: 18px;
  height: 18px;
  background: #e8f3fb;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: {{ section.settings.accent_color }};
  font-size: 10px;
  font-weight: 700;
}
.dv-card__footer {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.dv-card__pricing {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}
.dv-card__price {
  font-size: 22px;
  font-weight: 700;
  color: #0d1b2a;
}
.dv-card__old {
  font-size: 13px;
  color: #b0bec5;
  text-decoration: line-through;
}
.dv-card__save {
  font-size: 10px;
  background: #e8f5e9;
  color: #388e3c;
  padding: 3px 9px;
  border-radius: 100px;
  font-weight: 600;
}
.dv-card__rating {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: #6b8099;
}
.dv-card__stars { color: #f4a82e; }
.dv-card__btn {
  width: 100%;
  padding: 13px;
  border: none;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
  transition: background .2s, transform .15s;
  text-align: center;
  display: block;
  text-decoration: none;
}
.dv-card__btn--p1 {
  background: {{ section.settings.btn1_bg }};
  color: {{ section.settings.btn1_text }};
}
.dv-card__btn--p1:hover { opacity: .85; transform: translateY(-1px); color: {{ section.settings.btn1_text }}; }
.dv-card__btn--p2 {
  background: {{ section.settings.btn2_bg }};
  color: {{ section.settings.btn2_text }};
}
.dv-card__btn--p2:hover { opacity: .85; transform: translateY(-1px); color: {{ section.settings.btn2_text }}; }

@media screen and (max-width: 749px) {
  .dv-gamme { padding: 48px 20px; }
  .dv-gamme__grid { grid-template-columns: 1fr; gap: 20px; }
  .dv-card { grid-template-columns: 1fr; }
  .dv-card__img { min-height: 220px; }
  .dv-card__info { padding: 24px 20px; }
  .dv-card__name { font-size: 16px; }
}
</style>

<section class="dv-gamme">
  <div class="dv-gamme__tag">{{ section.settings.tag }}</div>
  <div class="dv-gamme__titre">{{ section.settings.titre }} <em>{{ section.settings.titre_accent }}</em></div>

  <div class="dv-gamme__grid">

    <!-- PRODUIT 1 -->
    <div class="dv-card dv-card--featured">
      <div class="dv-card__img">
        {% if section.settings.p1_nouveau %}
          <div class="dv-card__new">{{ section.settings.p1_badge }}</div>
        {% endif %}
        {% if section.settings.p1_image != blank %}
          <img src="{{ section.settings.p1_image | img_url: '600x' }}" alt="{{ section.settings.p1_nom }}">
        {% endif %}
      </div>
      <div class="dv-card__info">
        <div>
          <div class="dv-card__tag">{{ section.settings.p1_tag }}</div>
          <div class="dv-card__name">{{ section.settings.p1_nom }}</div>
          <div class="dv-card__desc">{{ section.settings.p1_desc }}</div>
          <ul class="dv-card__benefits">
            {% if section.settings.p1_b1 != blank %}<li><div class="dv-card__check">✓</div>{{ section.settings.p1_b1 }}</li>{% endif %}
            {% if section.settings.p1_b2 != blank %}<li><div class="dv-card__check">✓</div>{{ section.settings.p1_b2 }}</li>{% endif %}
            {% if section.settings.p1_b3 != blank %}<li><div class="dv-card__check">✓</div>{{ section.settings.p1_b3 }}</li>{% endif %}
          </ul>
        </div>
        <div class="dv-card__footer">
          <div class="dv-card__pricing">
            <span class="dv-card__price">{{ section.settings.p1_prix }}</span>
            {% if section.settings.p1_ancien != blank %}
              <span class="dv-card__old">{{ section.settings.p1_ancien }}</span>
            {% endif %}
          </div>
          {% assign p1 = section.settings.p1_produit %}
          {% if p1 != blank %}
            <form action="/cart/add" method="post">
              <input type="hidden" name="id" value="{{ p1.variants.first.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="dv-card__btn dv-card__btn--p1">{{ section.settings.p1_cta }}</button>
            </form>
          {% else %}
            <a href="{{ section.settings.p1_lien }}" class="dv-card__btn dv-card__btn--p1">{{ section.settings.p1_cta }}</a>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- PRODUIT 2 -->
    <div class="dv-card">
      <div class="dv-card__img dv-card__img--p2">
        {% if section.settings.p2_image != blank %}
          <img src="{{ section.settings.p2_image | img_url: '600x' }}" alt="{{ section.settings.p2_nom }}">
        {% endif %}
      </div>
      <div class="dv-card__info">
        <div>
          <div class="dv-card__tag">{{ section.settings.p2_tag }}</div>
          <div class="dv-card__name">{{ section.settings.p2_nom }}</div>
          <div class="dv-card__desc">{{ section.settings.p2_desc }}</div>
          <ul class="dv-card__benefits">
            {% if section.settings.p2_b1 != blank %}<li><div class="dv-card__check">✓</div>{{ section.settings.p2_b1 }}</li>{% endif %}
            {% if section.settings.p2_b2 != blank %}<li><div class="dv-card__check">✓</div>{{ section.settings.p2_b2 }}</li>{% endif %}
            {% if section.settings.p2_b3 != blank %}<li><div class="dv-card__check">✓</div>{{ section.settings.p2_b3 }}</li>{% endif %}
          </ul>
        </div>
        <div class="dv-card__footer">
          <div class="dv-card__pricing">
            <span class="dv-card__price">{{ section.settings.p2_prix }}</span>
            {% if section.settings.p2_ancien != blank %}
              <span class="dv-card__old">{{ section.settings.p2_ancien }}</span>
              <span class="dv-card__save">{{ section.settings.p2_reduction }}</span>
            {% endif %}
          </div>
          {% if section.settings.p2_avis != blank %}
            <div class="dv-card__rating">
              <span class="dv-card__stars">★★★★</span>
              <span>{{ section.settings.p2_avis }}</span>
            </div>
          {% endif %}
          {% assign p2 = section.settings.p2_produit %}
          {% if p2 != blank %}
            <form action="/cart/add" method="post">
              <input type="hidden" name="id" value="{{ p2.variants.first.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="dv-card__btn dv-card__btn--p2">{{ section.settings.p2_cta }}</button>
            </form>
          {% else %}
            <a href="{{ section.settings.p2_lien }}" class="dv-card__btn dv-card__btn--p2">{{ section.settings.p2_cta }}</a>
          {% endif %}
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Gamme Docteur V",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Couleurs generales" },
    { "type": "color", "id": "bg_color", "label": "Fond de la section", "default": "#f7f9fc" },
    { "type": "color", "id": "card_bg", "label": "Fond des cards", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Couleur accent", "default": "#5d9bd5" },
    { "type": "header", "content": "Titres" },
    { "type": "text", "id": "tag", "label": "Tag section", "default": "Notre gamme" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "La cure qui" },
    { "type": "text", "id": "titre_accent", "label": "Titre accent en bleu", "default": "fonctionne." },
    { "type": "header", "content": "Produit 1 - image et couleurs" },
    { "type": "image_picker", "id": "p1_image", "label": "Photo produit 1" },
    { "type": "color", "id": "img_bg_p1", "label": "Fond image produit 1", "default": "#e8f3fb" },
    { "type": "color", "id": "btn1_bg", "label": "Fond bouton produit 1", "default": "#5d9bd5" },
    { "type": "color", "id": "btn1_text", "label": "Texte bouton produit 1", "default": "#ffffff" },
    { "type": "header", "content": "Produit 1 - contenu" },
    { "type": "product", "id": "p1_produit", "label": "Selectionner produit 1 (pour ajout panier)" },
    { "type": "checkbox", "id": "p1_nouveau", "label": "Afficher badge nouveaute", "default": true },
    { "type": "text", "id": "p1_badge", "label": "Texte badge", "default": "Nouveaute" },
    { "type": "text", "id": "p1_tag", "label": "Tag", "default": "Cure 14 jours" },
    { "type": "text", "id": "p1_nom", "label": "Nom produit", "default": "Detox Draineur Slim 3-en-1" },
    { "type": "textarea", "id": "p1_desc", "label": "Description", "default": "Draine, elimine, detoxifie." },
    { "type": "text", "id": "p1_b1", "label": "Benefice 1", "default": "Anti-retention d'eau" },
    { "type": "text", "id": "p1_b2", "label": "Benefice 2", "default": "Detox foie et reins" },
    { "type": "text", "id": "p1_b3", "label": "Benefice 3", "default": "Resultats des J+7" },
    { "type": "text", "id": "p1_prix", "label": "Prix affiche", "default": "24,90€" },
    { "type": "text", "id": "p1_ancien", "label": "Prix barre (vide si aucun)" },
    { "type": "url", "id": "p1_lien", "label": "Lien si pas de produit selectionne" },
    { "type": "text", "id": "p1_cta", "label": "Texte bouton", "default": "Ajouter au panier" },
    { "type": "header", "content": "Produit 2 - image et couleurs" },
    { "type": "image_picker", "id": "p2_image", "label": "Photo produit 2" },
    { "type": "color", "id": "img_bg_p2", "label": "Fond image produit 2", "default": "#0d1b2a" },
    { "type": "color", "id": "btn2_bg", "label": "Fond bouton produit 2", "default": "#0d1b2a" },
    { "type": "color", "id": "btn2_text", "label": "Texte bouton produit 2", "default": "#ffffff" },
    { "type": "header", "content": "Produit 2 - contenu" },
    { "type": "product", "id": "p2_produit", "label": "Selectionner produit 2 (pour ajout panier)" },
    { "type": "text", "id": "p2_tag", "label": "Tag", "default": "Cure 2 mois" },
    { "type": "text", "id": "p2_nom", "label": "Nom produit", "default": "Moro Fit 400" },
    { "type": "textarea", "id": "p2_desc", "label": "Description", "default": "60 gelules au Morosil." },
    { "type": "text", "id": "p2_b1", "label": "Benefice 1", "default": "400 mg Morosil par jour" },
    { "type": "text", "id": "p2_b2", "label": "Benefice 2", "default": "Brule-graisse naturel" },
    { "type": "text", "id": "p2_b3", "label": "Benefice 3", "default": "Developpe par des pros de sante" },
    { "type": "text", "id": "p2_prix", "label": "Prix affiche", "default": "39,90€" },
    { "type": "text", "id": "p2_ancien", "label": "Prix barre", "default": "89,90€" },
    { "type": "text", "id": "p2_reduction", "label": "Badge reduction", "default": "-55%" },
    { "type": "text", "id": "p2_avis", "label": "Avis clients", "default": "4.4 (127 avis)" },
    { "type": "url", "id": "p2_lien", "label": "Lien si pas de produit selectionne" },
    { "type": "text", "id": "p2_cta", "label": "Texte bouton", "default": "Ajouter au panier" }
  ],
  "presets": [{ "name": "Gamme Docteur V" }]
}
{% endschema %}