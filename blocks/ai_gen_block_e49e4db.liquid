{% doc %}
  @prompt
    i need section on the left side to be able to add portrait vdeo or image and on the right side to be able to add text or custom liquid code,
    
    The text on the right side i need header and like list with number 1. title and below description
    
    To be able to change background of the section and also to be able to make center position middle text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-media-text-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-media-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-media-text-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
  }

  .ai-media-text-media-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.media_width }}%;
    max-width: {{ block.settings.media_width }}%;
  }

  .ai-media-text-media-inner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: {{ block.settings.media_border_radius }}px;
  }

  .ai-media-text-media-inner-{{ ai_gen_id }} img,
  .ai-media-text-media-inner-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-media-text-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-media-text-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-media-text-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-media-text-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-media-text-header-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0;
    line-height: 1.2;
  }

  .ai-media-text-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.list_gap }}px;
  }

  .ai-media-text-list-item-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
  }

  .ai-media-text-number-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.number_size }}px;
    height: {{ block.settings.number_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.number_bg_color }};
    color: {{ block.settings.number_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.number_font_size }}px;
    font-weight: 600;
  }

  .ai-media-text-list-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-media-text-list-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .ai-media-text-list-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  .ai-media-text-custom-liquid-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-media-text-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-media-text-media-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 100%;
    }

    .ai-media-text-header-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-media-text-list-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-media-text-list-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<media-text-section-{{ ai_gen_id }}
  class="ai-media-text-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-media-text-container-{{ ai_gen_id }}">
    <div class="ai-media-text-wrapper-{{ ai_gen_id }}">
      <div class="ai-media-text-media-{{ ai_gen_id }}">
        <div class="ai-media-text-media-inner-{{ ai_gen_id }}">
          {% if block.settings.media_type == 'video' and block.settings.video != blank %}
            <video
              autoplay
              muted
              loop
              playsinline
              {% if block.settings.video_poster %}
                poster="{{ block.settings.video_poster | image_url: width: 800 }}"
              {% endif %}
            >
              <source
                src="{{ block.settings.video }}"
                type="video/mp4"
              >
            </video>
          {% elsif block.settings.media_type == 'image' and block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% else %}
            <div class="ai-media-text-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-media-text-empty-state-{{ ai_gen_id }}">
                Add a portrait image or video
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-media-text-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-media-text-header-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.content_type == 'list' %}
          <ul class="ai-media-text-list-{{ ai_gen_id }}">
            {% for i in (1..5) %}
              {% liquid
                assign title_key = 'list_item_' | append: i | append: '_title'
                assign description_key = 'list_item_' | append: i | append: '_description'
                assign title = block.settings[title_key]
                assign description = block.settings[description_key]
              %}

              {% if title != blank or description != blank %}
                <li class="ai-media-text-list-item-{{ ai_gen_id }}">
                  <div class="ai-media-text-number-{{ ai_gen_id }}">{{ i }}</div>
                  <div class="ai-media-text-list-content-{{ ai_gen_id }}">
                    {% if title != blank %}
                      <h3 class="ai-media-text-list-title-{{ ai_gen_id }}">{{ title }}</h3>
                    {% endif %}
                    {% if description != blank %}
                      <div class="ai-media-text-list-description-{{ ai_gen_id }}">{{ description }}</div>
                    {% endif %}
                  </div>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% elsif block.settings.content_type == 'custom' %}
          <div class="ai-media-text-custom-liquid-{{ ai_gen_id }}">
            {{ block.settings.custom_liquid }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</media-text-section-{{ ai_gen_id }}>

<script>
  (function() {
    class MediaTextSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const video = this.querySelector('video');
        if (video) {
          video.play().catch(function() {});
        }
      }
    }

    customElements.define('media-text-section-{{ ai_gen_id }}', MediaTextSection{{ ai_gen_id }});
  })();
</script>

