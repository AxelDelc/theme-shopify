{% doc %}
  @prompt
    i need section with 2 column on right to have able to upload image 
    To be able center the content of the columns top center or bottom
        
     On the left to have one big title and then to be able to add FAQ accordion menu
    Also i want to add dynamic FAQ question how many i want and if we can manage the background color spacing margin padding 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
  }

  .ai-faq-section__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: {{ block.settings.content_alignment }};
  }

  .ai-faq-section__left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.left_content_gap }}px;
  }

  .ai-faq-section__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: 600;
    line-height: 1.2;
  }

  .ai-faq-section__accordion-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.faq_spacing }}px;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    border: 1px solid {{ block.settings.faq_border_color }};
    border-radius: {{ block.settings.faq_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.faq_background }};
  }

  .ai-faq-item__question-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.faq_padding }}px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: {{ block.settings.question_size }}px;
    color: {{ block.settings.question_color }};
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-faq-item__question-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.faq_hover_background }};
  }

  .ai-faq-item__icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
  }

  .ai-faq-item__icon-{{ ai_gen_id }}.active {
    transform: rotate(180deg);
  }

  .ai-faq-item__answer-wrapper-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-faq-item__answer-{{ ai_gen_id }} {
    padding: 0 {{ block.settings.faq_padding }}px {{ block.settings.faq_padding }}px;
    font-size: {{ block.settings.answer_size }}px;
    color: {{ block.settings.answer_color }};
    line-height: 1.6;
  }

  .ai-faq-section__right-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.image_horizontal_align }};
    align-items: {{ block.settings.image_vertical_align }};
  }

  .ai-faq-section__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-faq-section__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-faq-section__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-faq-section__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-faq-section__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  @media screen and (max-width: 768px) {
    .ai-faq-section__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-faq-section__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-faq-section__right-{{ ai_gen_id }} {
      order: {{ block.settings.mobile_image_position }};
    }

    .ai-faq-section__left-{{ ai_gen_id }} {
      order: {{ block.settings.mobile_content_position }};
    }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }} class="ai-faq-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-faq-section__container-{{ ai_gen_id }}">
    <div class="ai-faq-section__left-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-faq-section__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      <div class="ai-faq-section__accordion-{{ ai_gen_id }}">
        {% for i in (1..10) %}
          {% assign question_key = 'faq_question_' | append: i %}
          {% assign answer_key = 'faq_answer_' | append: i %}
          {% assign question = block.settings[question_key] %}
          {% assign answer = block.settings[answer_key] %}

          {% if question != blank and answer != blank %}
            <div class="ai-faq-item-{{ ai_gen_id }}" data-faq-item>
              <button
                class="ai-faq-item__question-{{ ai_gen_id }}"
                aria-expanded="false"
                data-faq-button
              >
                <span>{{ question }}</span>
                <svg
                  class="ai-faq-item__icon-{{ ai_gen_id }}"
                  data-faq-icon
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="ai-faq-item__answer-wrapper-{{ ai_gen_id }}" data-faq-answer>
                <div class="ai-faq-item__answer-{{ ai_gen_id }}">
                  {{ answer }}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-faq-section__right-{{ ai_gen_id }}">
      <div class="ai-faq-section__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-faq-section__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-faq-section__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-faq-section__empty-state-{{ ai_gen_id }}">
              Add an image
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</faq-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.faqItems = this.querySelectorAll('[data-faq-item]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.faqItems.forEach((item) => {
          const button = item.querySelector('[data-faq-button]');
          const answer = item.querySelector('[data-faq-answer]');
          const icon = item.querySelector('[data-faq-icon]');

          button.addEventListener('click', () => {
            const isOpen = button.getAttribute('aria-expanded') === 'true';

            if (isOpen) {
              this.closeItem(button, answer, icon);
            } else {
              this.openItem(button, answer, icon);
            }
          });
        });
      }

      openItem(button, answer, icon) {
        button.setAttribute('aria-expanded', 'true');
        icon.classList.add('active');
        answer.style.maxHeight = answer.scrollHeight + 'px';
      }

      closeItem(button, answer, icon) {
        button.setAttribute('aria-expanded', 'false');
        icon.classList.remove('active');
        answer.style.maxHeight = '0';
      }
    }

    customElements.define('faq-accordion-{{ ai_gen_id }}', FaqAccordion{{ ai_gen_id }});
  })();
</script>

