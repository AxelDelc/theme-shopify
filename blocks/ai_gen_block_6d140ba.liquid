{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-product-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-three-product-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-three-product-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .ai-three-product-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-three-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-three-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f3f3f3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-three-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-three-product-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ai-three-product-liquid-before-{{ ai_gen_id }} {
    font-size: 14px;
  }

  .ai-three-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0;
  }

  .ai-three-product-liquid-after-{{ ai_gen_id }} {
    font-size: 14px;
  }

  .ai-three-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 500;
  }

  .ai-three-product-button-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    text-align: center;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }

  .ai-three-product-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-three-product-liquid-after-button-{{ ai_gen_id }} {
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-three-product-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
{% endstyle %}

<three-product-grid-{{ ai_gen_id }} class="ai-three-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-product-container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign product_key = 'product_' | append: i
        assign image_key = 'product_' | append: i | append: '_image'
        assign title_key = 'product_' | append: i | append: '_title'
        assign price_key = 'product_' | append: i | append: '_price'
        assign use_dynamic_price_key = 'product_' | append: i | append: '_use_dynamic_price'
        assign liquid_before_key = 'product_' | append: i | append: '_liquid_before'
        assign liquid_after_key = 'product_' | append: i | append: '_liquid_after'
        assign liquid_after_button_key = 'product_' | append: i | append: '_liquid_after_button'
        assign description_key = 'product_' | append: i | append: '_description'
        assign liquid_after_desc_key = 'product_' | append: i | append: '_liquid_after_desc'


        assign product = block.settings[product_key]
        assign image = block.settings[image_key]
        assign title = block.settings[title_key]
        assign price = block.settings[price_key]
        assign use_dynamic_price = block.settings[use_dynamic_price_key]
        assign liquid_before = block.settings[liquid_before_key]
        assign liquid_after = block.settings[liquid_after_key]
        assign liquid_after_button = block.settings[liquid_after_button_key]
        assign description = block.settings[description_key]
        assign liquid_after_desc = block.settings[liquid_after_desc_key]
      %}

      <div class="ai-three-product-card-{{ ai_gen_id }}" data-product-index="{{ i }}">
  

        <div class="ai-three-product-image-wrapper-{{ ai_gen_id }}">
            {% if product %}
  {% assign variant = product.selected_or_first_available_variant %}

  {% if variant.compare_at_price 
    and variant.compare_at_price > variant.price %}

    {% assign savings = variant.compare_at_price | minus: variant.price %}

    {% assign discount_percent = savings
      | times: 100.0
      | divided_by: variant.compare_at_price
      | round %}

    <div class="ai-three-product-savings-wrapper-{{ ai_gen_id }}">
      <div class="savings-feature">
        Économise {{ savings | money }}
      </div>
      <div class="discount-feature">
        -{{ discount_percent }}%
      </div>
    </div>

  {% endif %}
{% endif %}
          {% if image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-three-product-image-{{ ai_gen_id }}"
            >
          {% elsif product and product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="lazy"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              class="ai-three-product-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-three-product-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-three-product-content-{{ ai_gen_id }}">
          {% if liquid_before != blank %}
            <div class="ai-three-product-liquid-before-{{ ai_gen_id }}">
              {{ liquid_before }}
            </div>
          {% endif %}

          {% if title != blank %}
            <h3 class="ai-three-product-title-{{ ai_gen_id }}">{{ title }}</h3>
          {% elsif product %}
            <h3 class="ai-three-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
          {% endif %}

          {% if liquid_after != blank %}
            <div class="ai-three-product-liquid-after-{{ ai_gen_id }}">
              {{ liquid_after }}
            </div>
          {% endif %}

        {% if description != blank %}
          <div class="smaller-text ai-three-product-description-{{ ai_gen_id }}">
            {{ description }}
          </div>
        {% endif %}

        {% if liquid_after_desc != blank %}
            <div class="ai-three-product-liquid-after-desc-{{ ai_gen_id }}">
              {{ liquid_after_desc }}
            </div>
          {% endif %}

         {% if use_dynamic_price and product %}
  {% assign variant = product.selected_or_first_available_variant %}

  <div class="price-new-section ai-three-product-price-{{ ai_gen_id }}">

    {% if variant.compare_at_price 
      and variant.compare_at_price > variant.price %}

      <span class="price-original">
        {{ variant.compare_at_price | money }}
      </span>

      <span class="price-sale">
        {{ variant.price | money }}
      </span>

      {% assign savings = variant.compare_at_price | minus: variant.price %}
      {% assign discount_percent = savings
        | times: 100.0
        | divided_by: variant.compare_at_price
        | round %}

      <span class="price-discount">
        -{{ discount_percent }}%
      </span>

    {% else %}

      <span class="price-regular">
        {{ variant.price | money }}
      </span>

    {% endif %}

  </div>

{% elsif price != blank %}
  <div class="ai-three-product-price-{{ ai_gen_id }}">
    {{ price }}
  </div>
{% endif %}


          {% if product %}
            <button
              type="button"
              class="ai-three-product-button-{{ ai_gen_id }}"
              data-product-id="{{ product.id }}"
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            >
              {{ block.settings.button_text }}
            </button>
          {% endif %}

          {% if liquid_after_button != blank %}
            <div class="ai-three-product-liquid-after-button-{{ ai_gen_id }}">
              {{ liquid_after_button }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</three-product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ThreeProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-three-product-button-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', (event) => {
            const productId = event.target.dataset.productId;
            const variantId = event.target.dataset.variantId;

            if (productId && variantId) {
              this.addToCart(variantId, button);
            }
          });
        });
      }

      addToCart(variantId, button) {
        const originalText = button.textContent;
        button.textContent = '{{ block.settings.button_loading_text }}';
        button.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        })
        .then(response => response.json())
        .then(data => {
          button.textContent = originalText;
          button.disabled = false;

          if (window.theme && window.theme.cart) {
            window.theme.cart.refresh();
          }

          document.dispatchEvent(new CustomEvent('cart:refresh'));

          const cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer && cartDrawer.open) {
            cartDrawer.open();
          }
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
          button.textContent = originalText;
          button.disabled = false;
        });
      }
    }

    customElements.define('three-product-grid-{{ ai_gen_id }}', ThreeProductGrid{{ ai_gen_id }});
  })();
</script>

