    "faq_7L8Mc3": {
      "type": "faq",
      "blocks": {
        "question_jkjKpG": {
          "type": "question",
          "settings": {
            "title": "<strong>À qui s’adresse le MOROFIT 400 ?</strong>",
            "text": "<p>Le <strong>MOROFIT 400</strong> s’adresse aux personnes qui veulent :</p><ul><li><strong>Affiner leur silhouette</strong> et cibler le tour de taille.<br/></li><li><strong>Activer naturellement leur métabolisme</strong> grâce à une formule hautement dosée.<br/></li><li>Obtenir un <strong>soutien minceur complet</strong> grâce au Morosil® 400 mg, au guarana, au vinaigre de cidre, à la noix de cola et au chrome.<br/></li><li><strong>Réduire les fringales</strong>, mieux gérer l’appétit et stabiliser la glycémie.<br/></li><li>Booster une <strong>routine minceur de 12 semaines</strong> avec un complément premium, efficace et synergique.<br/></li><li>Retrouver énergie, légèreté et motivation au quotidien.<br/></li></ul><p>Idéal pour celles et ceux qui veulent un <strong>véritable coup de pouce minceur</strong>, sans solutions extrêmes ni restrictions difficiles.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_MpnRWh": {
          "type": "question",
          "settings": {
            "title": "<strong>Gélules minceur : quelle posologie et quelle durée ?</strong>",
            "text": "<p>Prenez deux gélules par jour, idéalement le matin ou à midi, pendant trois mois pour respecter les recommandations.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_hbjEzc": {
          "type": "question",
          "settings": {
            "title": "<strong>Perte de poids : comment optimiser vos résultats ?</strong>",
            "text": "<p>Associez la cure (12 semaines) à une alimentation équilibrée et à de l’activité physique pour maximiser les effets du complément.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_VyC3gj": {
          "type": "question",
          "settings": {
            "title": "<strong>Accélérer le métabolisme et maigrir naturellement : quelles astuces ?</strong>",
            "text": "<p>Buvez beaucoup d’eau, consommez des aliments riches en fibres et pratiquez régulièrement une activité physique pour accompagner votre complément.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_FxNhrP": {
          "type": "question",
          "settings": {
            "title": "<strong>Morosil® : qu’est‑ce que c’est ?</strong>",
            "text": "<p>C’est un extrait d’orange sanguine Moro qui aide à réduire poids et tour de taille lorsqu’il est pris à la dose recommandée.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_3EL9HV": {
          "type": "question",
          "settings": {
            "title": "<strong>Morosil et vinaigre de cidre : pourquoi cette association ?</strong>",
            "text": "<p>Le mélange combine les bienfaits du Morosil® et l’effet tonique du vinaigre de cidre pour soutenir la silhouette et l’appétit.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_GNaBkM": {
          "type": "question",
          "settings": {
            "title": "<strong>Thé vert, EGCG et caféine : utile en minceur ?</strong>",
            "text": "<p>Les catéchines du thé vert et une dose modérée de caféine stimulent légèrement le métabolisme et l’oxydation des graisses.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_gyQQwL": {
          "type": "question",
          "settings": {
            "title": "<strong>Chrome et gestion du poids : à quoi sert‑il ?</strong>",
            "text": "<p>Cet oligo‑élément favorise un métabolisme normal des sucres et aide à stabiliser la glycémie, soutenant ainsi la régulation du poids.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
