            "liquid": "<style>\n/* BAR STORIES */\n.stories-bar{\n  display:flex;\n  gap:16px;\n  padding:15px;\n  overflow-x:auto;\n}\n\n/* CERCLES */\n.story-circle{\n  width:84px;\n  height:84px;\n  border-radius:50%;\n  border:4px solid #1e88e5;\n  overflow:hidden;\n  cursor:pointer;\n  background:#000;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  transition:.2s;\n  flex-shrink:0;\n}\n\n.story-circle:hover{\n  transform:scale(1.08);\n}\n\n.story-circle img{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n}\n\n/* POPUP */\n.story-popup{\n  position:fixed;\n  inset:0;\n  background:transparent;\n  display:none;\n  align-items:center;\n  justify-content:center;\n  z-index:999999;\n}\n\n/* BOX */\n.story-box{\n  width:360px;\n  max-width:90vw;\n  aspect-ratio:9/16;\n  background:#000;\n  position:relative;\n  border-radius:22px;\n  overflow:hidden;\n  box-shadow:0 25px 60px rgba(0,0,0,.45);\n}\n\n/* VIDEO */\n.story-box video{\n  width:100%;\n  height:100%;\n  object-fit:contain;\n}\n\n/* CONTROLS */\n.story-controls{\n  position:absolute;\n  bottom:70px;\n  left:0;\n  right:0;\n  display:flex;\n  justify-content:center;\n  gap:22px;\n  z-index:20;\n}\n\n.control-btn{\n  min-width:70px;\n  padding:10px 16px;\n  border-radius:25px;\n  background:rgba(0,0,0,.75);\n  color:#fff;\n  font-size:14px;\n  font-weight:600;\n  border:1px solid rgba(255,255,255,.3);\n  cursor:pointer;\n  backdrop-filter: blur(4px);\n  transition:.2s;\n}\n\n.control-btn:hover{\n  background:rgba(30,136,229,.8);\n}\n\n/* CLOSE */\n.story-close{\n  position:absolute;\n  top:10px;\n  right:12px;\n  background:transparent;\n  color:#fff;\n  font-size:28px;\n  cursor:pointer;\n  z-index:30;\n}\n\n/* ARROWS */\n.story-nav{\n  position:absolute;\n  top:50%;\n  transform:translateY(-50%);\n  color:#fff;\n  font-size:38px;\n  font-weight:700;\n  cursor:pointer;\n  z-index:30;\n  user-select:none;\n  padding:6px;\n}\n\n.story-prev{ left:6px; }\n.story-next{ right:6px; }\n</style>\n\n\n<!-- STORIES BAR -->\n<div class=\"stories-bar\">\n\n  <div class=\"story-circle\" data-index=\"0\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0923/6761/8397/files/pic_1.png?v=1769185427\">\n  </div>\n\n  <div class=\"story-circle\" data-index=\"1\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0923/6761/8397/files/pic_2.png?v=1769185445\">\n  </div>\n\n  <div class=\"story-circle\" data-index=\"2\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0923/6761/8397/files/pic_3.png?v=1769185459\">\n  </div>\n\n  <div class=\"story-circle\" data-index=\"3\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0923/6761/8397/files/pic_4.png?v=1769185472\">\n  </div>\n\n</div>\n\n\n<!-- POPUP -->\n<div class=\"story-popup\" id=\"storyPopup\">\n\n  <div class=\"story-box\">\n\n    <div class=\"story-close\" id=\"closeStory\">✕</div>\n\n    <div class=\"story-nav story-prev\" id=\"prevStory\">‹</div>\n    <div class=\"story-nav story-next\" id=\"nextStory\">›</div>\n\n    <video id=\"storyVideo\" playsinline></video>\n\n    <div class=\"story-controls\">\n\n      <button class=\"control-btn\" id=\"playPause\">⏸</button>\n      <button class=\"control-btn\" id=\"muteBtn\">🔊</button>\n\n    </div>\n\n  </div>\n\n</div>\n\n\n<script>\nconst videos = [\n \"https://cdn.shopify.com/videos/c/o/v/57231e33532046b492411a8e8451f587.mp4\",\n \"https://cdn.shopify.com/videos/c/o/v/b1e0c984e0c143b3a2f61d8c50136ee7.mov\",\n \"https://cdn.shopify.com/videos/c/o/v/c6016b240fa246e093a8c9238e712979.mov\",\n \"https://cdn.shopify.com/videos/c/o/v/3ba7d62681b04341acf2091dd8884beb.mov\"\n];\n\nlet current = 0;\n\nconst popup = document.getElementById(\"storyPopup\");\nconst video = document.getElementById(\"storyVideo\");\n\nconst playBtn = document.getElementById(\"playPause\");\nconst muteBtn = document.getElementById(\"muteBtn\");\n\n/* OPEN */\ndocument.querySelectorAll(\".story-circle\").forEach(story => {\n\n  story.addEventListener(\"click\", () => {\n\n    current = parseInt(story.dataset.index);\n    openStory(current);\n\n  });\n\n});\n\nfunction openStory(i){\n\n  current = (i + videos.length) % videos.length;\n\n  video.src = videos[current];\n  video.currentTime = 0;\n  video.muted = false;\n  video.play();\n\n  playBtn.textContent = \"⏸\";\n  muteBtn.textContent = \"🔊\";\n\n  popup.style.display = \"flex\";\n}\n\n/* PLAY */\nplayBtn.onclick = ()=>{\n\n  if(video.paused){\n    video.play();\n    playBtn.textContent = \"⏸\";\n  }else{\n    video.pause();\n    playBtn.textContent = \"⏯\";\n  }\n};\n\n/* SOUND */\nmuteBtn.onclick = ()=>{\n\n  video.muted = !video.muted;\n  muteBtn.textContent = video.muted ? \"🔇\" : \"🔊\";\n};\n\n/* NAV */\ndocument.getElementById(\"prevStory\").onclick = ()=> openStory(current-1);\ndocument.getElementById(\"nextStory\").onclick = ()=> openStory(current+1);\n\n/* CLOSE */\ndocument.getElementById(\"closeStory\").onclick = closeStory;\n\nfunction closeStory(){\n\n  video.pause();\n  video.src = \"\";\n  popup.style.display = \"none\";\n}\n\n/* CLICK OUTSIDE */\npopup.onclick = e=>{\n  if(e.target === popup) closeStory();\n};\n\n/* KEYBOARD */\ndocument.addEventListener(\"keydown\", e=>{\n\n  if(popup.style.display !== \"flex\") return;\n\n  if(e.key===\"Escape\") closeStory();\n  if(e.key===\"ArrowLeft\") openStory(current-1);\n  if(e.key===\"ArrowRight\") openStory(current+1);\n\n});\n\n/* SWIPE MOBILE */\nlet startX = 0;\n\ndocument.querySelector(\".story-box\").addEventListener(\"touchstart\", e=>{\n  startX = e.touches[0].clientX;\n});\n\ndocument.querySelector(\".story-box\").addEventListener(\"touchend\", e=>{\n\n  let endX = e.changedTouches[0].clientX;\n  let diff = endX - startX;\n\n  if(Math.abs(diff) > 50){\n\n    if(diff > 0) openStory(current-1);\n    else openStory(current+1);\n\n  }\n\n});\n</script>"
          }
