= parseInt(story.dataset.index);\n    openStory(current);\n\n  });\n\n});\n\nfunction openStory(i){\n\n  current = (i + videos.length) % videos.length;\n\n  video.src = videos[current];\n  video.currentTime = 0;\n  video.muted = false;\n  video.play();\n\n  playBtn.textContent = \"⏸\";\n  muteBtn.textContent = \"🔊\";\n\n  popup.style.display = \"flex\";\n}\n\n/* PLAY */\nplayBtn.onclick = ()=>{\n\n  if(video.paused){\n    video.play();\n    playBtn.textContent = \"⏸\";\n  }else{\n    video.pause();\n    playBtn.textContent = \"⏯\";\n  }\n};\n\n/* SOUND */\nmuteBtn.onclick = ()=>{\n\n  video.muted = !video.muted;\n  muteBtn.textContent = video.muted ? \"🔇\" : \"🔊\";\n};\n\n/* NAV */\ndocument.getElementById(\"prevStory\").onclick = ()=> openStory(current-1);\ndocument.getElementById(\"nextStory\").onclick = ()=> openStory(current+1);\n\n/* CLOSE */\ndocument.getElementById(\"closeStory\").onclick = closeStory;\n\nfunction closeStory(){\n\n  video.pause();\n  video.src = \"\";\n  popup.style.display = \"none\";\n}\n\n/* CLICK OUTSIDE */\npopup.onclick = e=>{\n  if(e.target === popup) closeStory();\n};\n\n/* KEYBOARD */\ndocument.addEventListener(\"keydown\", e=>{\n\n  if(popup.style.display !== \"flex\") return;\n\n  if(e.key===\"Escape\") closeStory();\n  if(e.key===\"ArrowLeft\") openStory(current-1);\n  if(e.key===\"ArrowRight\") openStory(current+1);\n\n});\n\n/* SWIPE MOBILE */\nlet startX = 0;\n\ndocument.querySelector(\".story-box\").addEventListener(\"touchstart\", e=>{\n  startX = e.touches[0].clientX;\n});\n\ndocument.querySelector(\".story-box\").addEventListener(\"touchend\", e=>{\n\n  let endX = e.changedTouches[0].clientX;\n  let diff = endX - startX;\n\n  if(Math.abs(diff) > 50){\n\n    if(diff > 0) openStory(current-1);\n    else openStory(current+1);\n\n  }\n\n});\n</script>"
