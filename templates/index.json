    "custom_liquid_hDf6Mb": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "liquid": "<style>\n/* ===== REELS ROW ===== */\n.reels-row{\n  display:flex;\n  gap:18px;\n  padding:18px 12px;\n  overflow-x:auto;\n}\n.reels-row::-webkit-scrollbar{display:none;}\n\n.reel-card{\n  width:260px;\n  aspect-ratio:9/16;\n  border-radius:18px;\n  overflow:hidden;\n  background:#000;\n  cursor:pointer;\n  flex-shrink:0;\n}\n\n@media(max-width:520px){\n  .reel-card{width:210px;}\n}\n\n.reel-card video{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  pointer-events:none; /* IMPORTANT */\n}\n\n/* ===== POPUP ===== */\n.reel-modal{\n  position:fixed;\n  inset:0;\n  display:none;\n  align-items:center;\n  justify-content:center;\n  z-index:999999;\n  background:transparent;\n}\n\n.reel-modal-inner{\n  width:360px;\n  max-width:92vw;\n  aspect-ratio:9/16;\n  background:#000;\n  border-radius:22px;\n  overflow:hidden;\n  position:relative;\n  box-shadow:0 28px 70px rgba(0,0,0,.45);\n}\n\n/* VIDEO */\n.reel-modal-inner video{\n  width:100%;\n  height:100%;\n  object-fit:contain;\n}\n\n/* CLOSE (NO CIRCLE) */\n.reel-close{\n  position:absolute;\n  top:10px;\n  right:12px;\n  background:transparent;\n  border:none;\n  color:#fff;\n  font-size:28px;\n  cursor:pointer;\n  z-index:30;\n}\n\n/* ARROWS (NO CIRCLE) */\n.reel-nav{\n  position:absolute;\n  top:50%;\n  transform:translateY(-50%);\n  background:transparent;\n  border:none;\n  box-shadow:none;\n  color:#fff;\n  font-size:38px;\n  font-weight:700;\n  cursor:pointer;\n  z-index:30;\n  user-select:none;\n  padding:6px;\n}\n\n.reel-prev{left:6px;}\n.reel-next{right:6px;}\n\n/* CONTROLS */\n.reel-controls{\n  position:absolute;\n  bottom:70px;\n  left:0;\n  right:0;\n  display:flex;\n  justify-content:center;\n  gap:16px;\n  z-index:30;\n}\n\n.reel-btn{\n  min-width:70px;\n  padding:10px 14px;\n  border-radius:999px;\n  background:rgba(0,0,0,.75);\n  color:#fff;\n  border:1px solid rgba(255,255,255,.25);\n  font-weight:700;\n  font-size:20px;\n  cursor:pointer;\n}\n\n.reel-btn:hover{\n  background:#1e88e5;\n  border-color:#1e88e5;\n}\n</style>\n\n\n<!-- ===== PREVIEW ROW ===== -->\n<div class=\"reels-row\">\n\n  <div class=\"reel-card\" data-i=\"0\">\n    <video muted autoplay loop playsinline>\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/57231e33532046b492411a8e8451f587.mp4\">\n    </video>\n  </div>\n\n  <div class=\"reel-card\" data-i=\"1\">\n    <video muted autoplay loop playsinline>\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/b1e0c984e0c143b3a2f61d8c50136ee7.mov\">\n    </video>\n  </div>\n\n  <div class=\"reel-card\" data-i=\"2\">\n    <video muted autoplay loop playsinline>\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/c6016b240fa246e093a8c9238e712979.mov\">\n    </video>\n  </div>\n\n  <div class=\"reel-card\" data-i=\"3\">\n    <video muted autoplay loop playsinline>\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/3ba7d62681b04341acf2091dd8884beb.mov\">\n    </video>\n  </div>\n\n</div>\n\n\n<!-- ===== MODAL ===== -->\n<div class=\"reel-modal\" id=\"modal\">\n\n  <div class=\"reel-modal-inner\">\n\n    <button class=\"reel-close\" id=\"close\">✕</button>\n\n    <div class=\"reel-nav reel-prev\" id=\"prev\">‹</div>\n    <div class=\"reel-nav reel-next\" id=\"next\">›</div>\n\n    <video id=\"player\" playsinline></video>\n\n    <div class=\"reel-controls\">\n      <button class=\"reel-btn\" id=\"play\">⏸</button>\n      <button class=\"reel-btn\" id=\"sound\">🔊</button>\n    </div>\n\n  </div>\n\n</div>\n\n\n<script>\nconst reels=[\n \"https://cdn.shopify.com/videos/c/o/v/57231e33532046b492411a8e8451f587.mp4\",\n \"https://cdn.shopify.com/videos/c/o/v/b1e0c984e0c143b3a2f61d8c50136ee7.mov\",\n \"https://cdn.shopify.com/videos/c/o/v/c6016b240fa246e093a8c9238e712979.mov\",\n \"https://cdn.shopify.com/videos/c/o/v/3ba7d62681b04341acf2091dd8884beb.mov\"\n];\n\nlet i=0;\n\nconst modal=document.getElementById(\"modal\");\nconst player=document.getElementById(\"player\");\n\nconst playBtn=document.getElementById(\"play\");\nconst soundBtn=document.getElementById(\"sound\");\n\nfunction openReel(n){\n i=(n+reels.length)%reels.length;\n\n player.src=reels[i];\n player.muted=false;\n player.play();\n\n modal.style.display=\"flex\";\n\n playBtn.textContent=\"⏸\";\n soundBtn.textContent=\"🔊\";\n}\n\nfunction closeReel(){\n player.pause();\n player.src=\"\";\n modal.style.display=\"none\";\n}\n\ndocument.querySelectorAll(\".reel-card\").forEach(c=>{\n c.onclick=()=>openReel(+c.dataset.i);\n});\n\nplayBtn.onclick=()=>{\n if(player.paused){\n   player.play();\n   playBtn.textContent=\"⏸\";\n }else{\n   player.pause();\n   playBtn.textContent=\"⏯\";\n }\n};\n\nsoundBtn.onclick=()=>{\n player.muted=!player.muted;\n soundBtn.textContent=player.muted?\"🔇\":\"🔊\";\n};\n\ndocument.getElementById(\"prev\").onclick=()=>openReel(i-1);\ndocument.getElementById(\"next\").onclick=()=>openReel(i+1);\ndocument.getElementById(\"close\").onclick=closeReel;\n\n/* keyboard */\ndocument.addEventListener(\"keydown\",e=>{\n if(modal.style.display!==\"flex\")return;\n\n if(e.key===\"Escape\")closeReel();\n if(e.key===\"ArrowLeft\")openReel(i-1);\n if(e.key===\"ArrowRight\")openReel(i+1);\n});\n</script>",
